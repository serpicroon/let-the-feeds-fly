# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# SQLite database file path
DATABASE=ltff.db

# HTTP request timeout in seconds
HTTP_TIMEOUT=60.0

# Cleanup entries older than N days
CLEANUP_AFTER_DAYS=60

# Scheduled feeds: one URL + interval (seconds, >= 60) per name.
# The registered URL must be byte-identical to the ?url= request parameter.
# Requests for scheduled feeds skip request-time sync and serve local data.
# SCHEDULED_FEED_LINUXDO_URL=https://linux.do/latest.rss
# SCHEDULED_FEED_LINUXDO_INTERVAL=1800
